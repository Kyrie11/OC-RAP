+cd /path/to/original/OC-RAP
+patch -p1 --dry-run < OC-RAP-v48.35.1-to-v48.35.2-ENGINEERING-INTEGRITY.patch
+patch -p1 < OC-RAP-v48.35.1-to-v48.35.2-ENGINEERING-INTEGRITY.patch
