+export GPU0=0
+export GPU1=1
+
+# 可移植 Safe WOMD 路径；生成的 NEXT_COMMANDS 会引用这里，而不是硬编码其他机器路径。
+export SAFE_WOMD_SOURCE=/absolute/path/to/waymo_open_dataset_motion_v_1_3_1/uncompressed/tf_example/validation/validation_tfexample.tfrecord@150
+
