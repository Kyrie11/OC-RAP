+============================================================
+
+一、优先使用完整修复包
+------------------------------------------------------------
+unzip OC-RAP-v48.35.2-ENGINEERING-INTEGRITY.zip
+cd OC-RAP-v48.35.2-ENGINEERING-INTEGRITY
+
+# 代码发布矩阵；不运行缺失历史资产，也不把 v50 测试计入 v48.35.2。
+bash scripts/run_v48_35_2_release_tests.sh
+
+# 静态检查。
+find scripts -maxdepth 1 -type f -name '*.sh' -print0 | xargs -0 -n1 bash -n
+PYTHONDONTWRITEBYTECODE=1 python -m compileall -q -f src tools tests
+
+二、修复服务器上本次已有结果；不重训、不重跑 certificate
+------------------------------------------------------------
+# 设置为本次结果目录。
+OUTPUTDIR=runs/ocrap_v48_35_continuous_frontier_dedicated_4835
+
+# 这批上传结果的预期权威终态是 RC=20。命令会把旧 RC=30 marker
+# 移入 status_history，并生成唯一权威状态文件。
+PYTHONPATH=tools:src python tools/audit_v48_35_run_state.py \
+  --run "$OUTPUTDIR" \
+  --output "$OUTPUTDIR/AUTHORITATIVE_RUN_STATUS.json" \
+  --expect-exit-code 20 \
+  --archive-stale-markers
+
+# 重新生成工程诊断；不会训练模型，也不会读取 test root。
+PYTHONPATH=tools:src python tools/check_v48_16_learning_gates.py \
+  --run "$OUTPUTDIR" \
+  --output "$OUTPUTDIR/learning_gates_v48_35.json" \
+  --version v48.35.2-ENGINEERING-INTEGRITY
+
+PYTHONPATH=tools:src python tools/summarize_v48_34_gate_failure.py \
+  --run "$OUTPUTDIR" \
+  --output "$OUTPUTDIR/GATE_FAILURE_DECOMPOSITION.json"
+
+# 全新构建结果 ZIP。不要再用 zip -r 更新已有 ZIP。
+RUN="$OUTPUTDIR" OUTPUT_ZIP="${OUTPUTDIR%/}-v48.35.2-clean.zip" \
+  bash scripts/package_v48_35_results.sh
+
+三、未来从全新输出目录执行主 pipeline
+------------------------------------------------------------
+# 必须使用一个从未被其他 attempt 使用过的新目录。
+export OUTPUTDIR=runs/ocrap_v48_35_2_engineering_integrity_$(date +%Y%m%d_%H%M%S)
+export OCRAP_ROOT=/absolute/path/to/OCRAP
+export SOURCE_RUN=/absolute/path/to/source_run
+export PROTOCOL_ROOT=/absolute/path/to/calibration_protocol
