@@ -0,0 +1,188 @@
+# OC-RAP v48.36.3 TERMINAL-STATE HOTFIX 下一步执行指令
+# 目标：修复 attempt/provenance 终态错误。不会训练、不会重新 calibration、不会修改算法结果。
+# 运行日期版本：v48.36.3-TERMINAL-STATE-HOTFIX
+
+set -u
+
+###############################################################################
+# A. 部署代码（推荐覆盖代码文件，但保留 runs/）
+###############################################################################
+
+REPO=/home/senzeyu2/code/OC-RAP
+DELIVERY_ZIP=/path/to/OC-RAP-v48.36.3-TERMINAL-STATE-HOTFIX.zip
+STAGE=/tmp/ocrap_v48363_delivery
+
+rm -rf "$STAGE"
+mkdir -p "$STAGE"
+unzip -q "$DELIVERY_ZIP" -d "$STAGE"
+rsync -a "$STAGE/OC-RAP-v48.36.3-TERMINAL-STATE-HOTFIX/" "$REPO/"
+
+cd "$REPO"
+export PYTHONPATH="$REPO/src${PYTHONPATH:+:$PYTHONPATH}"
+python -m compileall -q src tools tests
+bash -n scripts/run_v48_36_ocaf_dedicated.sh
+bash -n scripts/calibrate_v48_36_shared_certificate_pool.sh
+bash -n scripts/repair_v48_36_2_terminal_state_with_v48_36_3.sh
+pytest -q tests/test_v48_36_2_stage_transfer_hotfix.py tests/test_v48_36_3_terminal_state_hotfix.py
+
+###############################################################################
+# B. 当前上传结果对应的首选路径：只修 terminal state
+###############################################################################
+
+# 必须在原实验机上执行，并保留以下真实 checkpoint：
+# runs/ocrap_v48_36_1_ocaf_cuda_hotfix_48361/candidates/balanced/model_v48_trac_sr/best.pt
+# runs/ocrap_v48_36_1_ocaf_cuda_hotfix_48361/candidates/precision/model_v48_trac_sr/best.pt
+
+OUTPUTDIR=runs/ocrap_v48_36_1_ocaf_cuda_hotfix_48361
+
+# 先做人工只读检查；两个文件必须存在。
+for variant in balanced precision; do
+  test -f "$OUTPUTDIR/candidates/$variant/model_v48_trac_sr/best.pt" || {
+    echo "missing checkpoint: $variant" >&2
+    exit 30
+  }
+done
+
+# 精确签名 repair。脚本会备份、校验 checkpoint SHA256、校验证书/gate，
+# 修 status metadata，并重新运行两个权威 contract；未知差异会 fail closed。
+OUTPUTDIR="$OUTPUTDIR" \
+OCRAP_REPO="$REPO" \
+bash scripts/repair_v48_36_2_terminal_state_with_v48_36_3.sh
+
+python -m json.tool "$OUTPUTDIR/V48_36_3_TERMINAL_STATE_REPAIR.json"
+python -m json.tool "$OUTPUTDIR/V48_36_CERTIFICATE_STATUS_CONTRACT.json"
+python -m json.tool "$OUTPUTDIR/AUTHORITATIVE_RUN_STATUS.json"
+python -m json.tool "$OUTPUTDIR/V48_36_COMPLETE.json"
+
+# 必须同时满足：
+# V48_36_3_TERMINAL_STATE_REPAIR.json:
+#   valid=true
+#   authoritative_exit_code=20
+#   algorithm_changed=false
+#   retraining_performed=false
+#   recalibration_performed=false
+#   gate_decision_changed=false
+# AUTHORITATIVE_RUN_STATUS.json:
+#   valid=true
+#   authoritative_exit_code=20
+# V48_36_COMPLETE.json:
+#   pipeline_valid=true
