    "interpretation": "The deployed v48.30 selector failed. However, algorithm attribution is confounded by training/calibration contract mismatches."
  },
  "confirmed_engineering_findings": [
    {
      "id": "E1",
      "severity": "critical",
      "finding": "Training direct-policy validation did not apply the certificate eligibility filters feasible, hard<=max_hard, and nominal_deviation>=minimum.",
      "effect": "Checkpoint selection and adaptation-dev calibration counted different groups and opportunities."
    },
    {
      "id": "E2",
      "severity": "critical",
      "finding": "The all-abstain barrier used raw admissions rather than valid safe admissions.",
      "effect": "Harmful/invalid actions could make a checkpoint appear non-abstaining."
    },
    {
      "id": "E3",
      "severity": "critical",
      "finding": "v48.30 natural-without-replacement sampling was applied only to stage 2, while stage 1 remained stratified replacement and stage 2 froze benefit/harm factors.",
      "effect": "The natural prior repair could not correct the heads responsible for within-group action identity."
    },
    {
      "id": "E4",
      "severity": "high",
      "finding": "Checkpoint selection used a soft population objective and did not lexicographically require safe proposal top-1 support in both Near and Contact.",
      "effect": "A checkpoint with attractive candidate AUC/soft risk but zero executable safe admission could be selected."
    },
    {
      "id": "E5",
      "severity": "high",
      "finding": "Two learned safety coordinates are unsupported on the actual training index: hard_rule has zero positive eligible examples and harm_proxy is constant.",
      "effect": "A raw max-veto over these learned logits is not statistically identifiable and can dominate unified slack."
    },
    {
      "id": "E6",
      "severity": "medium",
      "finding": "Candidate-level AUC and scene opportunity detection were treated as stronger evidence than group-level action identity.",
      "effect": "Near AUC around 0.73-0.81 coexisted with near-zero/negative proposal top-1 correlation and zero certificate positives."
    },
    {
      "id": "E7",
      "severity": "critical",
      "finding": "The v48.30 development-shadow controller invokes audit_v48_30_shadow_provenance.py, check_v48_30_shadow_runtime_contract.py, and check_v48_30_regime_targets.py, but those files are absent from the uploaded code package.",
      "effect": "The uploaded v48.30 shadow log exits before simulation, so no v48.30 closed-loop physical conclusion is supported by this result package."
    }
  ],
