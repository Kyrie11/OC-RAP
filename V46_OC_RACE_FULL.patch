+#!/usr/bin/env bash
+set -euo pipefail
+
+export OCRAP_ROOT=${OCRAP_ROOT:-/data0/senzeyu2/dataset/OCRAP}
+export SAFE_TEST=${SAFE_TEST:-$OCRAP_ROOT/test_safe}
+export NEAR_TEST=${NEAR_TEST:-$OCRAP_ROOT/test_near_contact}
+export CONTACT_TEST=${CONTACT_TEST:-$OCRAP_ROOT/test_contact}
+export WOMD_VAL=${WOMD_VAL:-/data0/senzeyu2/dataset/WOMD/waymo_open_dataset_motion_v_1_3_1/uncompressed/tf_example/validation/validation_tfexample.tfrecord}
+export WOMD_VAL_INTERACTIVE=${WOMD_VAL_INTERACTIVE:-/data0/senzeyu2/dataset/WOMD/waymo_open_dataset_motion_v_1_3_1/uncompressed/tf_example/validation_interactive/validation_interactive_tfexample.tfrecord}
+
+# v46 OC-RACE evaluation. The frozen OC-MERO backbone remains unchanged.
+# A frozen shared encoder with observation-conditioned soft recovery-value
+# experts plus a relative-opportunity gate may augment admission in stress
+# regimes; no regime id selects a neural head. Safe remains nominal-locked.
+export RUN=${RUN:-runs/ocrap_v46_race_eval}
+export BASE_RUN=${BASE_RUN:-runs/ocrap_v46_race_regime_balanced}
+if [[ -z "${CKPT:-}" ]]; then
+  CKPT="$BASE_RUN/model_v46_race/best.pt"
+fi
+if [[ -z "${CAL:-}" ]]; then
+  CAL="$BASE_RUN/calibration/calibration_mix_v46.json"
+fi
+if [[ -z "${GAMMA:-}" ]]; then
+  GAMMA="$BASE_RUN/calibration/gamma_rec_by_bucket_v46.json"
+fi
+export CKPT CAL GAMMA
+mkdir -p "$RUN"
+
+# Exact closed-loop persistence controls. Reusing the same RUN/output filenames
+# resumes completed scene/target rollouts from *.json.partial or *.scenes.jsonl.
+export CL_RESUME=${CL_RESUME:-true}
+export CL_PARTIAL_EVERY=${CL_PARTIAL_EVERY:-4}
+export CL_RESUME_FSYNC=${CL_RESUME_FSYNC:-false}
+
+[[ -f "$CKPT" ]] || { echo "missing checkpoint $CKPT; set CKPT=/path/to/best.pt" >&2; exit 2; }
+[[ -f "$GAMMA" ]] || { echo "missing gamma map $GAMMA; set GAMMA=/path/to/gamma.json" >&2; exit 2; }
+[[ -f "$CAL" ]] || { echo "missing calibration $CAL; set CAL=/path/to/calibration.json" >&2; exit 2; }
+
+# v46 reads both an opportunity threshold and a observation-conditioned score
+# threshold. Refuse to execute a certificate that failed held-out verification.
+read_direct_rule() {
+  local path="$1"
+  python - "$path" <<'PYQ'
+import json, math, sys
+p=sys.argv[1]; d=json.load(open(p))
+s=float(d.get('direct_value_threshold', float('inf')))
+o=float(d.get('direct_value_opportunity_threshold', float('inf')))
+if not d.get('valid_for_active_contract', False) or not math.isfinite(s) or not math.isfinite(o):
+    raise SystemExit(f'invalid OC-RACE certificate: {p}')
+name={2:'brake',3:'yield',5:'merge',6:'pull_over',7:'stabilize'}
+macros=','.join(name[x] for x in d.get('supported_macro_ids', []) if x in name)
+if not macros:
+    raise SystemExit(f'OC-RACE certificate has no fit-supported macro family: {p}')
+print(s, o, macros)
+PYQ
+}
+read -r _NEAR_SCORE _NEAR_OPP _NEAR_MACROS < <(read_direct_rule "$BASE_RUN/calibration/direct_value_risk_near_v46.json")
+read -r _CONTACT_SCORE _CONTACT_OPP _CONTACT_MACROS < <(read_direct_rule "$BASE_RUN/calibration/direct_value_risk_contact_v46.json")
+NEAR_DIRECT_THRESHOLD=${NEAR_DIRECT_THRESHOLD:-$_NEAR_SCORE}
+NEAR_DIRECT_OPPORTUNITY_THRESHOLD=${NEAR_DIRECT_OPPORTUNITY_THRESHOLD:-$_NEAR_OPP}
+NEAR_DIRECT_MACROS=${NEAR_DIRECT_MACROS:-$_NEAR_MACROS}
+CONTACT_DIRECT_THRESHOLD=${CONTACT_DIRECT_THRESHOLD:-$_CONTACT_SCORE}
+CONTACT_DIRECT_OPPORTUNITY_THRESHOLD=${CONTACT_DIRECT_OPPORTUNITY_THRESHOLD:-$_CONTACT_OPP}
+CONTACT_DIRECT_MACROS=${CONTACT_DIRECT_MACROS:-$_CONTACT_MACROS}
+export NEAR_DIRECT_THRESHOLD CONTACT_DIRECT_THRESHOLD NEAR_DIRECT_OPPORTUNITY_THRESHOLD CONTACT_DIRECT_OPPORTUNITY_THRESHOLD
+export NEAR_DIRECT_MACROS CONTACT_DIRECT_MACROS
+echo "direct-value OC-RACE rules: near(score=$NEAR_DIRECT_THRESHOLD,opp=$NEAR_DIRECT_OPPORTUNITY_THRESHOLD,macros=$NEAR_DIRECT_MACROS) contact(score=$CONTACT_DIRECT_THRESHOLD,opp=$CONTACT_DIRECT_OPPORTUNITY_THRESHOLD,macros=$CONTACT_DIRECT_MACROS)"
+
+make_sel() {
+  local tag="$1"  # scalar | v46
+  local rel_near=false
+  local rel_contact=false
+  local rec_pool=false
+  local brake_rescue=false
+  local pcd_rescue=false
+  local brake_tail=false
+  local brake_tail_bypass_pcd=false
+  local direct_value=false
+  local is_v27=false
+  case "$tag" in
+    scalar) rel_near=false; rel_contact=false; rec_pool=false; brake_rescue=false; pcd_rescue=false; brake_tail=false; brake_tail_bypass_pcd=false; direct_value=false ;;
+    v46|v40|v27) rel_near=true; rel_contact=true; rec_pool=true; brake_rescue=${CONTACT_BRAKE_RESCUE:-false}; pcd_rescue=true; brake_tail=${CONTACT_BRAKE_TAIL:-false}; brake_tail_bypass_pcd=${CONTACT_TAIL_BYPASS_PCD_GAIN:-false}; direct_value=${RUN_DIRECT_VALUE:-true}; is_v27=true ;;
+    *) echo "unknown selector tag: $tag" >&2; exit 2 ;;
+  esac
+
+  COMMON_SEL=(
+    --set seed=${SEED:-7}
+    --set selection.gamma_rec_by_bucket_file="$GAMMA"
+    --set selection.ocrap_selector=calibrated_constrained
+    --set selection.auto_regime_from_observation=${AUTO_REGIME_FROM_OBSERVATION:-true}
+    --set regime_thresholds.tau_d=${AUTO_REGIME_TAU_D:-2.0}
+    --set regime_thresholds.tau_ttc=${AUTO_REGIME_TAU_TTC:-3.0}
+    --set regime_thresholds.tau_contact=${AUTO_REGIME_TAU_CONTACT:-0.8}
+    --set closed_loop.require_calibrated_selector=true
