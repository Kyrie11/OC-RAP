+
+BASE_RUN="$RUN" CKPT="$MODEL_DIR/best.pt" CAL_DIR="$CAL_DIR" CAL_GPU="$TRAIN_GPU" \
+  bash scripts/calibrate_ocrap_v46_race.sh
