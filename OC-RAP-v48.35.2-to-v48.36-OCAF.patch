+#!/usr/bin/env bash
+set -Eeuo pipefail
+
+# v48.36 OCAF / OBSERVATION-CONDITIONED ACTION FRONTIER
+# One unified, regime-agnostic selector trains and validates the exact deployed
+# order: frozen rank proposal -> opportunity/harm eligibility -> evidence rerank
+# -> one recovery action or nominal.  No regime id or regime-specific policy is
+# exposed to the model.
+REPO="${OCRAP_REPO:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
+cd "$REPO"
+export PYTHONPATH="$REPO/src${PYTHONPATH:+:$PYTHONPATH}"
+export CUBLAS_WORKSPACE_CONFIG="${CUBLAS_WORKSPACE_CONFIG:-:4096:8}"
+export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True,max_split_size_mb:128}"
+export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
+export MKL_NUM_THREADS="${MKL_NUM_THREADS:-2}"
+export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-2}"
+
+RUN="${RUN:?RUN is required}"
+INIT_CKPT="${INIT_CKPT:?INIT_CKPT is required}"
+VARIANT="${VARIANT:?VARIANT is required}"
+TRAIN_MIX="${TRAIN_MIX:?TRAIN_MIX is required}"
+VAL_MIX="${VAL_MIX:?VAL_MIX is required}"
+GROUP_INDEX="${GROUP_INDEX:?GROUP_INDEX is required}"
+TRAIN_GPU="${TRAIN_GPU:-0}"
+MODEL_DIR="${MODEL_DIR:-$RUN/model_v48_trac_sr}"
+CAL_DIR="${CAL_DIR:-$RUN/calibration}"
+mkdir -p "$RUN/logs" "$MODEL_DIR" "$CAL_DIR"
