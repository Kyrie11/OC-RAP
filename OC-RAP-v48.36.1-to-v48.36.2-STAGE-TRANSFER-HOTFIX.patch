+            variant_checks["legacy_disallowed_count_is_bridge_count"] = int(
+                old_transfer.get("identity_disallowed_changed_parameter_count", -1)
+            ) > 0
+            variant_checks["identity_architecture_exact"] = set(_trainable(identity_arch)) == set(
