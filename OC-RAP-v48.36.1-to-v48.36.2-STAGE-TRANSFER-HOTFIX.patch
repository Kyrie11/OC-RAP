+            )
+        except Exception as exc:
+            errors.append(f"{variant}_read_error")
+            details[f"{variant}_read_error"] = repr(exc)
+            continue
+
+        for name, condition in variant_checks.items():
+            record(f"{variant}_{name}", condition)
+        prepared[variant] = {
+            "run": run,
+            "source": source,
+            "factor": factor,
+            "identity": identity,
+            "final": final,
