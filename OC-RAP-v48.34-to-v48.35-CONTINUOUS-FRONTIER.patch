@@ -0,0 +1,132 @@
+OC-RAP v48.35 CONTINUOUS-FRONTIER 下一步执行指令
+=================================================
+
+原则
+----
+1. 主实验只读取 train/evidence_adapt_dev/certificate_pool，不读取 test。
+2. Near/Contact 只作为证书审计分层；模型不输入 regime ID，且只拟合一份共享 rule。
+3. RC=0 才会生成 NEXT_COMMANDS.txt，并授权 Safe paired non-inferiority 与 held-out stress。
+4. RC=20 是有效算法拒绝；不要执行 test，也不要调 gate。
+5. RC=30 是工程/协议错误；该次结果不得用于算法归因。
+
+一、进入仓库与环境
+------------------
+cd /path/to/OC-RAP-v48.35-CONTINUOUS-FRONTIER
+export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
+export OCRAP_ROOT=/data0/senzeyu2/dataset/OCRAP
+export SOURCE_RUN=runs/ocrap_v48_13_terra_proxy_4801
+export PROTOCOL_ROOT=$OCRAP_ROOT/calibration_v48_14_prism_4814
+export CAL_SAFE=$OCRAP_ROOT/calibration_safe
+export GPU0=0
+export GPU1=1
+
+二、CPU预检（必须全部通过）
+------------------------
+python tools/check_v48_35_frontier_contract.py \
+  --output runs/v48_35_preflight/CONTINUOUS_FRONTIER_CONTRACT.json
+
+python -m compileall -q src tools tests
+
+pytest -q \
+  tests/test_v48_33_eligible_set_policy.py \
+  tests/test_v48_34_1_rc30_model_contract_hotfix.py \
+  tests/test_v48_34_barrier_crossfit.py \
+  tests/test_v48_35_continuous_frontier.py
+
+find scripts -type f -name '*.sh' -print0 | xargs -0 -n1 bash -n
+
+三、主实验（推荐，两个A30并行Balanced/Precision）
+---------------------------------------------
+export OUTPUTDIR=runs/ocrap_v48_35_continuous_frontier_dedicated_4835
+
+set +e
+bash scripts/run_v48_35_continuous_frontier_dedicated.sh \
+  2>&1 | tee "$OUTPUTDIR/controller.console.log"
+RC=${PIPESTATUS[0]}
+set -e
+echo "v48.35 pipeline RC=$RC"
+
+python - <<'PY'
+import json, pathlib
+p=pathlib.Path('runs/ocrap_v48_35_continuous_frontier_dedicated_4835/V48_35_COMPLETE.json')
+print(json.dumps(json.load(open(p)), ensure_ascii=False, indent=2))
+PY
+
+四、根据RC执行
+------------
+A. RC=0
+~~~~~~~
+主控制器会生成：
+  $OUTPUTDIR/NEXT_COMMANDS.txt
+
+逐行检查后执行：
+  bash -lc "$(sed -n '2p' "$OUTPUTDIR/NEXT_COMMANDS.txt")"
+  bash -lc "$(sed -n '3p' "$OUTPUTDIR/NEXT_COMMANDS.txt")"
+
+也可直接执行受授权包装器：
+
+BASE_RUN=$(cat "$OUTPUTDIR/chosen_base_run_dedicated.txt") \
+RUN="$OUTPUTDIR/safe_paired" \
+OUT="$OUTPUTDIR" \
+SAFE_NOMINAL_ONLY=1 RUN_SAFE_PAIRED_SCALAR=1 \
+SAFE_WOMD_SOURCE=/data0/senzeyu2/dataset/WOMD/waymo_open_dataset_motion_v_1_3_1/uncompressed/tf_example/validation/validation_tfexample.tfrecord@150 \
+SAFE_RAW_MAX_SCENARIOS=0 \
+bash scripts/run_v48_35_safe_noninferiority.sh
+
+OUT="$OUTPUTDIR" \
+RUN="$OUTPUTDIR/stress_closed_loop" \
+bash scripts/run_v48_35_stress_if_authorized.sh
+
+B. RC=20
+~~~~~~~~
+不要读取test。先汇总：
+
+python tools/summarize_v48_34_gate_failure.py \
+  --run "$OUTPUTDIR" \
+  --output "$OUTPUTDIR/GATE_FAILURE_DECOMPOSITION.json"
+
+重点检查：
+  1. candidates/*/calibration/dev_frozen_shared_rule_v48.json
+  2. shared rule 的 by_stratum constraint_failures/constraint_deficit
+  3. direct_value_risk_near_v48.json 与 direct_value_risk_contact_v48.json
+  4. proposal_deployed_rule_* 指标（不要再使用旧字段名做新归因）
+  5. CONTINUOUS_FRONTIER_CONTRACT.json、MODEL_INFERENCE_CONTRACT.json、TRAINING_CONTRACT.json
+
+随后执行下面的2x2消融，不读取test：
+
+MAIN_RUN="$OUTPUTDIR" \
+ABLATION_ROOT=runs/ocrap_v48_35_continuous_frontier_ablations_4835 \
+SOURCE_RUN="$SOURCE_RUN" OCRAP_ROOT="$OCRAP_ROOT" PROTOCOL_ROOT="$PROTOCOL_ROOT" \
+GPU0=0 GPU1=1 \
+bash scripts/run_v48_35_continuous_frontier_ablations.sh
+
+消融解释：
+  A legacy relative + safety_slack
+  B physical_relative + safety_slack
+  C legacy relative + frontier_capped_slack
+  D physical_relative + frontier_capped_slack（主实验）
+
+只比较 pipeline_exit_code 为0或20且 pipeline_valid=true、gate_evaluated=true 的任务。
+任何RC=30任务不进入算法表。
+
+C. RC=30
+~~~~~~~~
+不要做算法结论。依次查看：
+  $OUTPUTDIR/PIPELINE_FAILED.json
+  $OUTPUTDIR/V48_35_COMPLETE.json
+  $OUTPUTDIR/FAILURE_SIGNATURE_balanced.json
+  $OUTPUTDIR/FAILURE_SIGNATURE_precision.json
+  $OUTPUTDIR/logs/*.log
+
+优先排查：数据/scene role、checkpoint SHA、factor cache、共享rule SHA、脚本依赖、CUDA/OOM、空proposal rows。
+修复工程问题后使用新的OUTPUTDIR重跑，避免继承陈旧状态文件。
+
+五、论文主表准入条件
+------------------
+Near和Contact同时满足以下条件前，不进入CCF-A主结论：
+1. 同一共享rule在adaptation-dev满足注册约束；
+2. scene-disjoint certificate上RC=0；
+3. Safe paired non-inferiority通过；
+4. 同scene-ID、同target、同rollout horizon的paired closed-loop显示稳定收益；
+5. 报告所有失败例，不只挑正向视频；
+6. 多seed/置信区间支持结论。
