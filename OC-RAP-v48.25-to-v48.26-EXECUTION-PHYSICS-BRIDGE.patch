+    --max-verify-harmful-selected-ucb="$CONTACT_MAX_VERIFY_SELECTED_HARM_UCB" \
+    2>&1 | tee "$run/logs/v48_26_policy_contact.log"; local sc=${PIPESTATUS[0]}
+  set -e
+
