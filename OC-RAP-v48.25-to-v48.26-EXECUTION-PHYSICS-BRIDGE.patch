+    --min-fit-selected="$NEAR_MIN_VERIFY_SELECTED" --min-fit-precision-lcb="$NEAR_MIN_VERIFY_PRECISION_LCB" \
+    --max-fit-harmful-group-ucb="$NEAR_MAX_VERIFY_HARM_UCB" \
+    --max-fit-harmful-selected-ucb="$NEAR_MAX_VERIFY_SELECTED_HARM_UCB" \
