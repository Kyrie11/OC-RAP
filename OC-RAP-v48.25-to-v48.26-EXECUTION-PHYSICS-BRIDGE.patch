+#!/usr/bin/env bash
+set -euo pipefail
+
+# v48.26 EXECUTION-PHYSICS-BRIDGE
+# One bucket-invariant model evaluates both frozen source experts for every
+# candidate. EXECUTION-PHYSICS-BRIDGE first fixes the missing runtime wiring for the semantic
+# risk prior/frontier, uses an executable-admission checkpoint barrier, and evaluates a
+# rule frozen on adaptation-dev against the full dedicated certificate population. No regime id or regime-specific strategy is exposed.
+REPO="${OCRAP_REPO:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
+cd "$REPO"
+export PYTHONPATH="$REPO/src${PYTHONPATH:+:$PYTHONPATH}"
+export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True,max_split_size_mb:128}"
+export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
+export MKL_NUM_THREADS="${MKL_NUM_THREADS:-2}"
+export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-2}"
+
+RUN="${RUN:?RUN is required}"
+INIT_CKPT="${INIT_CKPT:?INIT_CKPT is required}"
+VARIANT="${VARIANT:?VARIANT is required}"
+TRAIN_MIX="${TRAIN_MIX:?TRAIN_MIX is required}"
+VAL_MIX="${VAL_MIX:?VAL_MIX is required}"
+GROUP_INDEX="${GROUP_INDEX:?GROUP_INDEX is required}"
+TRAIN_GPU="${TRAIN_GPU:-0}"
+MODEL_DIR="${MODEL_DIR:-$RUN/model_v48_trac_sr}"
+CAL_DIR="${CAL_DIR:-$RUN/calibration}"
+mkdir -p "$RUN/logs" "$MODEL_DIR" "$CAL_DIR"
+
+PROPOSAL_TOP_K="${PROPOSAL_TOP_K:-3}"
+CAL_HIDDEN="${EVIDENCE_CALIBRATOR_HIDDEN:-16}"
+CAL_SCALE="${EVIDENCE_CALIBRATOR_SCALE:-0.75}"
+CAL_CONTEXT="${EVIDENCE_CALIBRATOR_CONTEXT:-true}"
+CAL_CONTEXT_SOURCE="${EVIDENCE_CALIBRATOR_CONTEXT_SOURCE:-tournament}"
+COMPONENT_HEADS="${EVIDENCE_COMPONENT_HEADS:-true}"
+SETWISE_WEIGHT="${SETWISE_W:-1.00}"
+COMPONENT_TAIL_WEIGHT="${ORDINAL_EVIDENCE_COMPONENT_TAIL_WEIGHT:-0.50}"
+BATCH_BALANCED="${ORDINAL_EVIDENCE_BATCH_BALANCED:-true}"
+GLOBAL_BALANCE="${ORDINAL_EVIDENCE_GLOBAL_BALANCE:-true}"
+MAX_CALIBRATOR_PARAMS="${MAX_EVIDENCE_CALIBRATOR_PARAMS:-8000}"
+BEST_METRIC_NAME="${BEST_METRIC:-direct_integrity_selection_risk}"
+STRATIFIED_BATCHES="${GROUP_BATCH_STRATIFIED:-true}"
+CONCORD_ENABLED="${EVIDENCE_CONCORD:-true}"
+ADMISSION_ENABLED="${EVIDENCE_ADMISSION_HEAD:-true}"
+SAFE_BENEFIT_TARGET="${ORDINAL_EVIDENCE_SAFE_BENEFIT_TARGET:-true}"
+GROUP_OPPORTUNITY_WEIGHT="${ORDINAL_EVIDENCE_GROUP_OPPORTUNITY_WEIGHT:-0.0}"
+DISAGREEMENT_PENALTY="${EVIDENCE_CONSENSUS_DISAGREEMENT_PENALTY:-0.15}"
+
+FRONTIER_ENABLED="${EVIDENCE_FRONTIER:-true}"
+COMPONENT_PRIOR_LOGIT="${EVIDENCE_COMPONENT_PRIOR_LOGIT:--2.0}"
+CATEGORICAL_GROUP_POLICY="${ORDINAL_EVIDENCE_CATEGORICAL_GROUP_POLICY:-true}"
+BENEFIT_LISTWISE_WEIGHT="${ORDINAL_EVIDENCE_BENEFIT_LISTWISE_WEIGHT:-0.75}"
+BENEFIT_LISTWISE_TEMPERATURE="${ORDINAL_EVIDENCE_BENEFIT_LISTWISE_TEMPERATURE:-0.08}"
+FRONTIER_PAIRWISE_WEIGHT="${ORDINAL_EVIDENCE_FRONTIER_PAIRWISE_WEIGHT:-0.75}"
+FRONTIER_PAIRWISE_MARGIN="${ORDINAL_EVIDENCE_FRONTIER_PAIRWISE_MARGIN:-0.20}"
+SAFE_UTILITY_REGRESSION_WEIGHT="${ORDINAL_EVIDENCE_SAFE_UTILITY_REGRESSION_WEIGHT:-1.0}"
+SAFE_UTILITY_LISTWISE_WEIGHT="${ORDINAL_EVIDENCE_SAFE_UTILITY_LISTWISE_WEIGHT:-0.75}"
+SAFE_UTILITY_TEMPERATURE="${ORDINAL_EVIDENCE_SAFE_UTILITY_TEMPERATURE:-0.10}"
+if [[ "$CONCORD_ENABLED" == true ]]; then
+  TRAINABLE_PREFIXES='direct_evidence_concord_benefit_calibrator,direct_evidence_concord_harm_calibrator'
+  if [[ "$ADMISSION_ENABLED" == true ]]; then
+    TRAINABLE_PREFIXES+=',direct_evidence_concord_admission_calibrator'
+  fi
+else
+  TRAINABLE_PREFIXES='direct_evidence_unified_calibrator'
