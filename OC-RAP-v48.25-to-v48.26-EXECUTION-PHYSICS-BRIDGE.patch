+fi
+
+cat > "$RUN/STAGE_ARCHITECTURE.json" <<JSON
+{
+  "version": "v48.26-EXECUTION-PHYSICS-BRIDGE",
+  "source_checkpoint": "$INIT_CKPT",
+  "training_role": "unified_non_regime_specific_safe_set_admission",
