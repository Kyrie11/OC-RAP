+  if [[ "$sn" == 4 || "$sc" == 4 ]]; then return 30; fi
+  if [[ ( "$sn" == 0 || "$sn" == 3 ) && ( "$sc" == 0 || "$sc" == 3 ) ]]; then return 20; fi
