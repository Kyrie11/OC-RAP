+六、RC=20 后运行 8 个非重复消融，平均分配到两张 A30
+------------------------------------------------------
+
+export ABLATION_ROOT=runs/ocrap_v48_26_execution_physics_ablations_4826
+mkdir -p "$ABLATION_ROOT"
+
+ABLATION_ROOT="$ABLATION_ROOT" \
