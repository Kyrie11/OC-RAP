+    train_keys = _constructor_keywords(ROOT / "src" / "ocrap" / "cli" / "train.py")
+    inference_keys = _constructor_keywords(ROOT / "src" / "ocrap" / "models" / "inference.py")
+    assert required <= train_keys
+    assert required <= inference_keys
